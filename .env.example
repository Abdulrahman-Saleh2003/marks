# ===================================================================
# Django Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your production values
# ===================================================================

# Security & Core
DJANGO_SECRET_KEY=generate-a-strong-random-key-here
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,127.0.0.1,localhost

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,http://localhost:3000

# Email (Gmail SMTP or Relay)
ADMIN_EMAIL=admin@example.com
DEFAULT_FROM_EMAIL=admin@example.com
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=admin@example.com
EMAIL_HOST_PASSWORD=your-google-app-password-16-chars

# Telegram Bot Notifications (Instant Alerts)
TELEGRAM_BOT_TOKEN=1234567890:AAF...
TELEGRAM_CHAT_ID=123456789

# Database (Optional: defaults to sqlite3 db.sqlite3 if omitted)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname
